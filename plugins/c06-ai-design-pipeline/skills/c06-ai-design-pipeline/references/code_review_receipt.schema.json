{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "C06CodeReviewReceipt",
  "type": "object",
  "required": [
    "domain",
    "review_version",
    "task_id",
    "reviewer",
    "author_actor",
    "commit_oid",
    "spec_sha256",
    "diff_sha256",
    "round",
    "verdict",
    "findings",
    "nonce",
    "iat",
    "exp",
    "key_id",
    "signature",
    "ts"
  ],
  "properties": {
    "domain": { "const": "c06/code-review/v1" },
    "review_version": { "const": 1 },
    "task_id": { "type": "string" },
    "reviewer": {
      "type": "object",
      "required": ["runner", "model", "role"],
      "properties": {
        "runner": { "type": "string" },
        "model": { "type": "string" },
        "role": { "const": "review" }
      }
    },
    "author_actor": { "type": "string" },
    "commit_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "spec_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "diff_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "round": { "type": "integer", "minimum": 1, "maximum": 3 },
    "verdict": { "enum": ["APPROVE", "BLOCK", "WAIVED"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "file", "line", "claim", "evidence", "fix"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["P0", "P1", "P2"] },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "claim": { "type": "string" },
          "evidence": { "type": "string" },
          "fix": { "type": "string" }
        }
      }
    },
    "nonce": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
    "iat": { "type": "integer" },
    "exp": { "type": "integer" },
    "user_waiver_auth": { "$ref": "#/definitions/UserAuthEnvelope" },
    "key_id": { "type": "string", "pattern": "^ed25519:reviewer(:v[0-9]+)?$" },
    "signature": { "type": "string", "pattern": "^sig:ed25519:[A-Za-z0-9+/=_-]+$" },
    "ts": { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "UserAuthEnvelope": {
      "type": "object",
      "required": ["domain", "task_id", "action", "subject_sha", "turn", "nonce", "iat", "exp", "key_id", "signature"],
      "properties": {
        "domain": { "const": "c06/user-auth/v1" },
        "task_id": { "type": "string" },
        "action": { "const": "WAIVER_GRANT" },
        "subject_sha": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "turn": { "type": "integer", "minimum": 1 },
        "nonce": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
        "iat": { "type": "integer" },
        "exp": { "type": "integer" },
        "key_id": { "type": "string", "pattern": "^ed25519:user(:v[0-9]+)?$" },
        "signature": { "type": "string", "pattern": "^sig:ed25519:[A-Za-z0-9+/=_-]+$" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "APPROVE" } } },
      "then": {
        "properties": {
          "findings": {
            "type": "array",
            "items": {
              "properties": {
                "severity": { "not": { "enum": ["P0", "P1"] } }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "verdict": { "const": "WAIVED" } } },
      "then": { "required": ["user_waiver_auth"] }
    }
  ],
  "additionalProperties": false
}