{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "C06TaskPackage",
  "type": "object",
  "required": [
    "domain",
    "task_id",
    "lane",
    "goal",
    "base_sha",
    "codebase_map_sha",
    "worktree_path",
    "branch_name",
    "owned_paths",
    "forbidden_paths",
    "acceptance_criteria",
    "budget_tokens",
    "timeout_seconds",
    "return_schema",
    "nonce",
    "iat",
    "exp",
    "key_id",
    "signature",
    "ts"
  ],
  "properties": {
    "domain": {
      "const": "c06/task-package/v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "lane": {
      "enum": [
        "L0-A",
        "L0-B",
        "L1",
        "L2"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 10
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "codebase_map_sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "worktree_path": {
      "type": "string"
    },
    "branch_name": {
      "type": "string"
    },
    "owned_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "object",
      "required": [
        "test_cmd",
        "expected_code",
        "min_coverage"
      ],
      "properties": {
        "test_cmd": {
          "type": "string"
        },
        "expected_code": {
          "type": "integer"
        },
        "min_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "budget_tokens": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 200000
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 900
    },
    "return_schema": {
      "type": "string"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "iat": {
      "type": "integer"
    },
    "exp": {
      "type": "integer"
    },
    "key_id": {
      "type": "string",
      "pattern": "^ed25519:commander(:v[0-9]+)?$"
    },
    "signature": {
      "type": "string",
      "pattern": "^sig:ed25519:[A-Za-z0-9+/=_-]+$"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "spec_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "spec_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scope_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "l0_mode": {
      "enum": [
        "pure_deletion",
        "static_style"
      ]
    },
    "lease_id": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "deletion_proof": {
      "type": "object",
      "required": [
        "task_id",
        "tool",
        "tool_sha256",
        "base_sha",
        "removed_paths",
        "removed_symbols",
        "incoming_refs",
        "entrypoint_refs",
        "nonce",
        "iat",
        "exp",
        "key_id",
        "signature"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "tool_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "removed_symbols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "incoming_refs": {
          "const": 0
        },
        "entrypoint_refs": {
          "const": 0
        },
        "key_id": {
          "type": "string",
          "pattern": "^ed25519:static_analyzer(:v[0-9]+)?$"
        },
        "signature": {
          "type": "string",
          "pattern": "^sig:ed25519:[A-Za-z0-9+/=_-]+$"
        },
        "task_id": {
          "type": "string"
        },
        "removed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "nonce": {
          "type": "string",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "iat": {
          "type": "integer"
        },
        "exp": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "rollback_strategy": {
      "type": [
        "string",
        "object"
      ],
      "properties": {
        "mode": {
          "enum": [
            "git_revert",
            "clean_worktree",
            "custom_script"
          ]
        },
        "command": {
          "type": "string"
        },
        "verify_command": {
          "type": "string"
        }
      }
    },
    "commit_oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lane": {
            "enum": [
              "L0-A",
              "L0-B"
            ]
          }
        }
      },
      "then": {
        "required": [
          "l0_mode"
        ],
        "properties": {
          "spec_path": {
            "type": "null"
          },
          "spec_sha256": {
            "type": "null"
          },
          "scope_sha": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lane": {
            "enum": [
              "L0-A",
              "L0-B"
            ]
          },
          "l0_mode": {
            "const": "static_style"
          }
        }
      },
      "then": {
        "required": [
          "lease_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "lane": {
            "enum": [
              "L1",
              "L2"
            ]
          }
        }
      },
      "then": {
        "required": [
          "spec_path",
          "spec_sha256",
          "scope_sha"
        ],
        "properties": {
          "spec_path": {
            "type": "string"
          },
          "spec_sha256": {
            "type": "string"
          },
          "scope_sha": {
            "type": "string"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}