{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "C06CodebaseMap",
  "type": "object",
  "required": [
    "domain",
    "schema_version",
    "base_sha",
    "payload",
    "content_sha",
    "key_id",
    "signature",
    "envelope"
  ],
  "properties": {
    "domain": { "const": "c06/codebase-map/v1" },
    "schema_version": { "const": 1 },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "payload": {
      "type": "object",
      "required": [
        "base_sha",
        "design_tokens",
        "stores",
        "components",
        "test_commands",
        "forbidden_zones"
      ],
      "properties": {
        "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "design_tokens": {
          "type": "object",
          "required": ["source_file", "prefix", "tokens"],
          "properties": {
            "source_file": { "type": "string" },
            "prefix": { "type": "string" },
            "tokens": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          }
        },
        "stores": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["file", "type", "keys"],
            "properties": {
              "file": { "type": "string" },
              "type": { "enum": ["zustand", "redux", "localstorage", "react-context"] },
              "keys": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "components": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["file", "exported_props"],
            "properties": {
              "file": { "type": "string" },
              "exported_props": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "test_commands": {
          "type": "object",
          "required": ["smoke_cmd", "unit_cmd"],
          "properties": {
            "smoke_cmd": { "type": "string" },
            "unit_cmd": { "type": "string" }
          }
        },
        "forbidden_zones": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "content_sha": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "key_id": { "type": "string", "pattern": "^ed25519:gate(:v[0-9]+)?$" },
    "signature": { "type": "string", "pattern": "^sig:ed25519:[A-Za-z0-9+/=_-]+$" },
    "envelope": {
      "type": "object",
      "required": ["extracted_at", "extractor_version"],
      "properties": {
        "extracted_at": { "type": "string", "format": "date-time" },
        "extractor_version": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}