  "major_identity_policy": {
    "mode": "major_identity_first",
    "interpretation": "In a mixed/all-cell major run, retain the best coherent major identity and move cross-lineage, ambient, contamination, and doublet risk to explicit downstream review fields. Multi_cell requires no coherent dominant identity or cell-level validated mixture/doublet evidence.",
    "qc_exception": {
      "enabled_with_project_prior": true,
      "allowed_labels": [
        "debris",
        "Low_quality"
      ],
      "minimum_qc_state_fraction_top50": 0.3
    }
  },
  "project_major_vocabulary_policy": {
    "interpretation": "A project label is a tiebreaker or output projection, never a replacement for a coherent identity program.",
    "identity_equivalences": {
      "Mesothelial_cell": [
        "Mesothelial_cell",
        "Stromal_cell"
      ]
    }
  },
  "major_parent_identity_gates": [
    {
      "rule_id": "REQUIRE_B_PARENT_PROGRAM_FOR_B_DESCENDANTS",
      "ancestors": [
        "B_cell"
      ],
      "descendants_only": true,
      "required_anchors": [
        "CD79A",
        "CD79B",
        "MS4A1",
        "PAX5",
        "EBF1"
      ],
      "minimum_required_anchors": 3,
      "anchor_detection_floor": 0.1,
      "interpretation": "A memory/naive/activated B child program cannot compete in major mode without a coherent B-lineage parent program."
    },
    {
      "rule_id": "REQUIRE_T_PARENT_PROGRAM_FOR_T_DESCENDANTS",
      "ancestors": [
        "T_cell"
      ],
      "descendants_only": true,
      "required_anchors": [
        "CD3D",
        "CD3E",
        "CD3G",
        "TRAC"
      ],
      "minimum_required_anchors": 2,
      "anchor_detection_floor": 0.1,
      "interpretation": "T-state or subtype programs require a coherent CD3/TCR parent program."
    },
    {
      "rule_id": "REQUIRE_EPITHELIAL_PARENT_PROGRAM_FOR_EPITHELIAL_DESCENDANTS",
      "ancestors": [
        "Epithelial_cell",
        "Lung_epithelial"
      ],
      "descendants_only": true,
      "required_anchors": [
        "EPCAM",
        "KRT8",
        "KRT18",
        "KRT19",
        "CLDN18"
      ],
      "minimum_required_anchors": 2,
      "anchor_detection_floor": 0.1,
      "interpretation": "Tissue-secreted genes alone do not establish an epithelial child identity without structural epithelial support."
    }
  ],
  "project_prior_identity_rules": [
    {
      "rule_id": "VALIDATE_PROJECT_PRIOR_ILC2_PROGRAM",
      "label": "ILC2",
      "parent_path": [
        "Cell",
        "Immune_cell",
        "Innate_lymphoid_cell",
        "ILC2"
      ],
      "core_markers": {
        "IL1RL1": 0.1,
        "GATA3": 0.1,
        "RORA": 0.1,
        "IL7R": 0.1
      },
      "minimum_core_markers": 3,
      "supportive_markers": {
        "AREG": 0.1,
        "CALCA": 0.1,
        "IL2RA": 0.1
      },
      "minimum_supportive_markers": 1,
      "forbidden_markers": {
        "CD3D": 0.2,
        "CD3E": 0.2,
        "TRAC": 0.2,
        "NKG7": 0.3,
        "MS4A1": 0.2
      },
      "maximum_forbidden_markers": 1,
      "interpretation": "A project-prior ILC2 call requires a coherent IL1RL1/GATA3/RORA/IL7R type-2 innate program with supportive effector genes and without a competing T, NK, or B parent program.",
      "evidence_ids": [
        "SRC_CL",
        "SRC_USER_MAP"
      ]
    }
  ],
  "tnk_rules": {
    "nk_specific_anchors": [
      "NCR1",
      "NCR3",
      "FCGR3A",
      "KLRF1"
    ]
  },
  "competing_program_policy": {
    "minimum_core_review": 3,
    "minimum_core_strong": 2,
    "minimum_specificity": 0.1,
    "interpretation": "A second identity program must be directionally enriched above dataset background and competitive with the primary; absolute detection or an ontology ancestor is not a mixed-population signal."
  },
  "off_parent_audit": {
    "enabled_with_full_ratio": true,
    "minimum_core_review": 3,
    "minimum_core_strong": 2,
    "minimum_specificity": 0.1
  },
  "negative_conflict_relative_reference_min_fraction": 0.5,
  "mutually_exclusive_program_rules": [
    {
      "rule_id": "ARBITRATE_ALPHA_BETA_VS_GAMMA_DELTA_TCR",
      "sides": {
        "alpha_beta": {
          "ancestors": [
            "CD4_T",
            "CD8_T"
          ],
          "anchors": [
            "TRAC",
            "TRBC1",
            "TRBC2"
          ],
          "minimum_anchors": 2,
          "detection_floor": 0.1
        },
        "gamma_delta": {
          "ancestors": [
            "gdT"
          ],
          "anchors": [
            "TRDC",
            "TRGC1",
            "TRGC2"
          ],
          "minimum_anchors": 2,
          "detection_floor": 0.1
        }
      },
      "minimum_dominance_ratio": 1.25,
      "minimum_absolute_margin": 0.1,
      "biological_invariant": "Conventional alpha-beta and gamma-delta T-cell identities are defined by competing receptor programs; aggregate dual detection cannot establish dual identity.",
      "validation_ladder": [
        "cluster_prevalence",
        "marker_differential_enrichment",
        "cell_level_coexpression",
        "paired_scTCR_or_protein"
      ]
    },
    {
      "rule_id": "ARBITRATE_TCR_VS_NK_IDENTITY",
      "sides": {
        "t_cell": {
          "ancestors": [
            "T_cell"
          ],
          "anchors": [
            "CD3D",
            "CD3E",
            "CD3G",
            "TRAC"
          ],
          "minimum_anchors": 2,
          "detection_floor": 0.1
        },
        "nk_cell": {
          "ancestors": [
            "NK_cell"
          ],
          "anchors": [
            "NKG7",
            "KLRD1",
            "NCR1",
            "GNLY"
          ],
          "minimum_anchors": 3,
          "detection_floor": 0.1
        }
      },
      "minimum_dominance_ratio": 1.25,
      "minimum_absolute_margin": 0.1,
      "biological_invariant": "Shared cytotoxic genes do not define NK identity when a broad coherent TCR program dominates and NK-specific receptors are absent.",
      "validation_ladder": [
        "cluster_prevalence",
        "marker_differential_enrichment",
        "cell_level_coexpression",
        "paired_scTCR_or_protein"
      ]
    }
  ],
